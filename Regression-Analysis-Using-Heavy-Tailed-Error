reg_loc <- function(y, x, model = c("st", "ssn", "scn", "t") )
{
	n <- length(y); N <- 4000; cri <- 10e-6; j <- 2; eps <- 1
	K <- rep(NA, n)
	k <- dim( cbind(y, x) )[2]
	x <- as.matrix(x, nrow = n, ncol = k -1)
	y_trim <- (y < quantile(y, 0.8) & y > quantile(y, 0.2) )
	X1 <- cbind(y[y_trim], x[y_trim,])
	Beta <- as.vector( lm( X1[, 1] ~ X1[, 2:k] )$coefficients )
	mu <- 0#mean(y[y_trim])
	m3 <- mean( (y - mu)^3 )
	sigma <- sd( y[y_trim] )
	lambda <- sign(m3/sigma^3)[1]
	b0 <- 10
		if( model == "scn" )
		{
			out <- matrix(NA, ncol = (5 + k), nrow = N)
			nu <- 0.5; gam <- 0.5
			out[1, (k + 1):(k + 5)] <- c(mu, sigma, lambda, nu, gam)
		}
		if( (model == "st" | model == "ssn" | model == "t") )
		{
			out <- matrix(NA, ncol = (4 + k), nrow = N)
			nu <- 8
			out[1, (k + 1):(k + 4)] <- c(mu, sigma, lambda, nu)
		}
	out[1, 1:k] <- Beta
	Del <- lambda/sqrt(1 + lambda^2)*sigma
	Gam <- (1 - lambda^2/(1 + lambda^2))*sigma^2
	X <- cbind(1, x)
	while(eps > 0.5 & j < N)
	{
		y0 <- y - X%*%Beta; 
		d <- (y0 - mu)^2/sigma^2
		A <- lambda*(y0 - mu)/sigma
		Mu <- Del/(Gam + Del^2)*(y0 - mu)
		M <- sqrt( Gam/(Gam + Del^2) )
		if( model == "scn" )
		{
			pdf0 <- dscn( y0, par = c(mu, sigma, lambda, nu, gam) ) 
			pdf0 <- ifelse(pdf0 > 10e-16, pdf0, 10e-16)
			K    <- 2*(nu*gam*dnorm(y0, mean = mu, sd = sigma/sqrt(gam))*pnorm( sqrt(gam)*A ) +
				  (1 - nu)*dnorm(y0, mean = mu, sd = sigma)*pnorm( A ) )/pdf0
			tau  <- 2*(nu*sqrt(gam)*dnorm(y0, mean = mu, sd = sigma/sqrt(gam))*pnorm( sqrt(gam)*A ) +
				  (1 - nu)*dnorm(y0, mean = mu, sd = sigma)*pnorm( A ) )/pdf0		
		}
		if( model == "ssn" )
		{
			pdf0 <- dssn( y0, par = c(mu, sigma, lambda, nu) ) 
			pdf1 <- dssn( y0, par = c(mu, sigma, lambda, nu + 1) ) 
			#K <- nu*2^(nu + 2)*gamma(nu + 3/2)*pgamma(1, shape = nu + 3/2, rate = d/2)/( d^(nu + 3/2)*sqrt(pi)*sigma*pdf0 )*exp_trunc( y0, par = c(mu, sigma, lambda, nu) )
			tau  <- exp( log(nu) + (nu + 1)*log(2) + lgamma(nu + 1) - (nu + 1)*log(d + A^2) - log(pdf0*pi*sigma) + pgamma(1, shape = nu + 1, rate = (d + A^2)/2, log.p = TRUE ) )
			K <-nu/(nu+1)*pdf1/pdf0
		}
		if(model == "st")
		{
			pdf0 <- dst( y0, par = c(mu, sigma, lambda, nu) ) 
			pdf0 <- ifelse(pdf0 > 10e-16, pdf0, 10e-16)
			K <- 4*nu^(nu/2)*gamma( (nu + 3)/2 )*(d + nu)^( -(nu + 3)/2 )*
			pt(sqrt( (nu + 3)/(d + nu) )*A, df = nu + 3)/( pdf0*gamma(nu/2)*sqrt(pi)*sigma )
			tau <- 2*nu^(nu/2)*gamma( (nu + 2)/2 )*(d + nu + A^2)^(-( nu + 2)/2 )/( pdf0*gamma(nu/2)*pi*sigma )
		}
		if(model == "t")
		{
			pdf0 <- dt( (y0 - mu)/sigma, df = nu )/sigma
			K <- 4*nu^(nu/2)*gamma( (nu + 3)/2 )*(d + nu)^( -(nu + 3)/2 )/( 2*pdf0*gamma(nu/2)*sqrt(pi)*sigma )
			tau <- 2*nu^(nu/2)*gamma( (nu + 2)/2 )*(d + nu + 0)^(-( nu + 2)/2 )/( pdf0*gamma(nu/2)*pi*sigma )
			Mu  <- 0; M <- 1; 
		}
		s2 <- K*Mu + M*tau
		s3 <- K*Mu^2 + M^2 + Mu*M*tau
		mu <- 0#sum(K*y0 - Del*s2)/sum(K)
		Del <- ifelse(model == "t", 0, sum((y0 - mu)*s2)/sum(s3) )
		Gam <- abs( sum( K*(y0 - mu)^2 - 2*(y0 - mu)*Del*s2 + Del^2*s3 ) )/n
		sigma <- sqrt(Del^2 + Gam)
		lambda <- Del/sqrt(Gam)
		Beta <- solve( matrix(crossprod(c(sqrt(K))*X), nrow = k, ncol = k) )%*%( t(X)%*%(y*K) )
		if( model == "scn" )
		{
			omega <- 2*nu*dnorm(y0, mean = mu, sd = sigma/sqrt(gam) )*pnorm( sqrt(gam)*A )/pdf0
			nu  <- sum(omega)/n
			obj <- function(w) sum( -dscn(y0, par = c(mu, sigma, lambda, nu, w), log = TRUE) ) ##
			gam <- suppressWarnings( optimize(obj, c(0.1, 0.99))$minimum )
			out[j, ] <- c(Beta, mu, sigma, lambda, nu, gam)
		}
		if( model == "ssn" )
		{
			obj <- function(w) sum( -dssn(y0, par = c(mu, sigma, lambda, w), log = TRUE) ) ##
			#obj=function(w){sapply(1:length(w), function(r) sum(-dssn(y0, par = c(mu, sigma, lambda, w[r]), log = TRUE)))}
			nu  <- suppressWarnings( optimize(obj, c(0.51, 70))$minimum )
			out[j, ] <- c(Beta, mu, sigma, lambda, nu)
		}
		if( model == "st" )
		{
			obj <- function(w) sum( -dst(y0, par = c(mu, sigma, lambda, w), log = TRUE) ) ##
			nu  <- suppressWarnings( optimize(obj, c(1.01, 150))$minimum )
			b_nu <- sqrt( nu/pi )*gamma( (nu - 1)/2 )/gamma( nu/2 )
			out[j, ] <- c(Beta, mu, sigma, lambda, nu)
		}
		if( model == "t" )
		{
			obj <- function(x) sum( -1/sigma*dt( (y0 - mu)/sigma, df = x, log = TRUE) ) ##
			nu  <- suppressWarnings( optimize(obj, c(1.01, 150))$minimum )
			out[j, ] <- c(Beta, mu, sigma, lambda, nu)
		}
		#out[j, ] <- c(Beta, mu, sigma, lambda, nu)
		#print(c(j,out[j, 1:6])); #out[1:j,]#
		if( sum(abs(out[j - 1, 1:(k )] - out[j, 1:(k )]))< cri || j >= (N - 1) )
		{
			eps <- 0
			}else{ 
			j <- j + 1 
		}
	}
		if( model == "st" )
		{
				estimator <- list(Beta = out[j - 1, 1:k], mu = out[j - 1, k + 1], sigma = out[j - 1, k + 2], 
				lambda = out[j - 1, k + 3], nu = out[j - 1, k + 4])
		}
		if( (model == "ssn" | model == "t") )
		{
				estimator <- list(Beta = out[j - 1, 1:k], mu = out[j - 1, k + 1], sigma = out[j - 1, k + 2], 
