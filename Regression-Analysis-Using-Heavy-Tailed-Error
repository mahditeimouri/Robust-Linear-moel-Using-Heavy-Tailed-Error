server = function(input, output) 
{
	data <- reactive({ 
	req(input$file1);
	if( input$sep == "." ) 
	{
	library(readxl)
	req(input$sheet);
	dat0 <- read_excel(input$file1$datapath, sheet=input$sheet); dat = as.data.frame(dat0);	
	}else{
	req(input$sep); req(input$quote); req(input$header);
	dat <- read.csv(input$file1$datapath, header = input$header, sep = input$sep, quote = input$quote)
	}
		if( input$trans_y == "Log" )
		{
			let <- !( is.na( dat$y ) | abs( dat$y ) == Inf | dat$y <= 0 )
			if( any( let ) != FALSE  ) 
			warning('y contains missing, infinite, or negative values')
			dat <- dat[let, ]
			dat$y <- log( dat$y )
		}else if( input$trans_y == "sr" ) {
			let <- !( is.na( dat$y ) | abs( dat$y ) == Inf | dat$y <= 0 )
			if( any( let ) != FALSE  ) 
			warning('y contains missing, infinite, or negative values')
			dat <- dat[let, ]
			dat$y <- sqrt( dat$y )
		}else if( input$trans_y == "cr" ) {
			let <- !( is.na( dat$y ) | abs( dat$y ) == Inf | dat$y <= 0 )
			if( any( let ) != FALSE  ) 
			warning('y contains missing or infinite values')
			dat <- dat[let, ]
			dat$y <- ( dat$y )^(1/3)
		}
	return(dat)
})
