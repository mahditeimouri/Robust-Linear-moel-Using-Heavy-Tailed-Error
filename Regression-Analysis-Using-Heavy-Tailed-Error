reg_plot <- function(x, y, PI = FALSE, interval = c("c", "p"),...)
{
 	model <- lm(y~x)
 	out <- summary(model)
 	b0 <- round(out$coefficien[1,1], 4)
 	b1 <- round(out$coefficien[2,1], 4)
 	note1 <- paste("Y=", b0, "+", b1, "X")
 	note2 <- paste( "R.squared=", round(out$r.squared, 4) ) 
	n <- length(x)
 	new <- data.frame(x = seq(min(x), max(x), length = n))
 	if(PI == FALSE)
 	{
 		plot(x, y,...)
 		curve(b0 + b1*x, add = TRUE)
 		lines(new$x, b0 + b1*new$x)
 		#text(mean(x), max(y), note1)
 		#text(mean(x), quantile(y, 0.90), note2)
 	}else if(PI == TRUE){
 		pred <- predict(model, new, interval = interval)
 		plot(x, y,...)
 		x0<-c(new$x[1:n], new$x[n:1])
 		y0<-c(pred[, 2], pred[n:1, 3])
		polygon(x0, y0, col = "light green", border = "red", cex=2,lty=2, lwd= 2)
 		#text(mean(x), max(y), note1)
 		#text(mean(x), quantile(y, 0.90), note2)
 		points(x, y,...)
		curve(b0 + b1*x, add = TRUE, col = 'blue', lwd=2)
 	}
}
