robust_reg <- function(y, x, type = c("mean", "location"), model = c("st", "ssn", "scn", "t", "sas"), Fisher = FALSE)
{
	if( any(is.na(y)) ) warning('y contains missing values')
	if( any(is.na(x)) ) warning('x contains missing values')
	k <- dim( cbind(y, x) )[2]
	Message <- FI <- matrix(NA, ncol = k + 3, nrow = k + 3)
	n <- length(y)
	if ( model == "sas" ) 
	{
		out <- reg_sas(y, x)
		est <- c(out$gamm, out$alpha) # if skewness then: est <- c(out$gamm, out$lambda, out$alpha)
	}
	if ( model == "t" ) 
	{
		out <- reg_mean(y, x, model = model )
		est <- c(out$sigma, out$nu)
	}
	if ( ( model == "st" & type == "location" ) ) 
	{
		out <- reg_loc(y, x, model = model)
		est <- c(out$sigma, out$lambda, out$nu)
	}else if ( ( model == "st" & type == "mean" ) ){
		out <- reg_mean(y, x, model = model)
		est <- c(out$sigma, out$lambda, out$nu)
	}
	Beta <- c( out$Beta )
	out6 <- rbind( c(0, est) )
	rownames(out6) <- c("[1]")
	std.error <- rep(NA, k)
	statistic <- rep(NA, k)
	p.value <- rep(NA, k)
	if( Fisher == TRUE )
	{
		if ( model == "st" ) 
		{
			if( type == "mean" )
			{
				FI <- FI_mean(x, param = c(Beta, est), m = 10, h = 0.005)
			}else if( type == "location" ) 
			{
				FI <- FI_loc(x, param = c(Beta, est), m = 10, h = 0.005)
			}
			colnames(out6) <- c("Location", "Scale", "Skewness", "DF")
		}
			if ( model == "sas" ) 
			{
				FI <- FI_sas(x, param = c(Beta, est), m = 10, h = 0.005)
				colnames(out6) <- c("Location", "Scale", "Tail index")	
			}
				if ( model == "t" ) 
				{
					FI <- FI_t(x, param = c(Beta, est), m = 10, h = 0.005)
					colnames(out6) <- c("Location", "Scale", "DF")	
				}
					FI_inv <- solve( FI[1:k, 1:k], tol = 10e-200 )
					if( any(FI_inv[1] == "NaN") ) 
					{
						Message <- c("FI is not invertible") 
					}else{ 
						e <- 1; Message <- FI_inv 
					}
				std.error <- sqrt( (diag( FI_inv )) )
				statistic <- Beta/std.error
				tail <- cbind( ( 1 - pt(statistic, n - k) ), pt(statistic, n - k) )
				p.value <- 2*apply(tail, 1, min)
	}
	out1 <- cbind(Beta, std.error, statistic, p.value)
	rownames(out1) <- c("beta.0 (Intercept)", sapply(1:k, function(i) (paste0("beta.",i," (x",i,")"))))[1:k]
	if ( model == "t" )
	{
		colnames(out1) <- c( "Estimate", "Std. Error", "t value", "Pr(>|t|)" )  
	}else if ( ( model == "sas" | model == "st" ) )
	{
		colnames(out1) <- c( "Estimate", "Std. Error", "Statistic", "P.value" )
	}
	error <- c( y - cbind(1, x)%*%Beta )
	S.E <- sum( error^2 )
	S.R <- sum( ( cbind(1, x)%*%Beta - mean(y) )^2 )
	S.T <- (n - 1)*var(y)
	if( k == 2)
	{
	out2 <- c(noquote( c(noquote(paste("y =", sep=" ", round(Beta[1], 5) )), 
			sapply(1:(k - 1), function(i) paste0(ifelse(sign(Beta[i+1]) > 0, "+", "-"),
			sep = " ",round( abs(Beta[i+1]), 5), "*", "x") ) )))
	}else if (k > 2)
	{
	out2 <- c(noquote( c(noquote(paste("y =", sep=" ", round(Beta[1], 5) )), 
			sapply(1:(k - 1), function(i) paste0(ifelse(sign(Beta[i+1]) > 0, "+", "-"),
			sep = " ", round( abs(Beta[i+1]), 5), "*", "x", i) ) )))
	}
	out3 <- cbind(round(min(error),4), round(quantile(error, 0.25)[[1]], 4), round(quantile(error, 0.50)[[1]],4),
	round(mean(error),4), round(quantile(error, 0.75)[[1]],4), round(max(error),4))
	colnames(out3) <- c("Min", "1Q", "Median", "Mean", "3Q", "Max")
	rownames(out3) <- c("[1]")
	#F.value <- (S.T - S.E)/S.E*(n - k)/(k - 1)
	#out4 <- cbind( F.value, k - 1, n - k, 1 - pf(F.value, k - 1, n - k) )
	out5 <- cbind( 1 - S.E/S.T, 1 - (n - 1)/(n - k)*(S.E/S.T) )
	colnames(out5) <- cbind("Multiple", "Adjusted")
	rownames(out5) <- c("R.square")
		if( (Fisher == TRUE & e == 1) )
		{
			out7 <- FI[1:k, 1:k]
			colnames(out7) <- c("beta.0", colnames( out7[, 2:k], do.NULL = FALSE, prefix = "beta.") )
			rownames(out7) <- c("beta.0", sapply(1:k, function(i) (paste0("beta.",i))))[1:k]
		}else if( (Fisher == TRUE & e == 0) )
		{
			out7 <- Message
		}else{
			out7 <- NULL
		}
	list( "coefficients" = out1, "model" = out2, "residual" = out3, "R.square" = out5, "error" = out6, 
		"FI" = out7 )
}
