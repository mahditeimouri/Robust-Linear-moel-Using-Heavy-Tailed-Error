GOF <- function(x, dist = "pnorm", par = c(0, 1), npar)
{
	n <- length(x)
	index <- 1:n
	s_x   <- sort(x)
	#n_par <- length(par)
	if( dist == "pnorm" )
	{ 
		log_pdf <- dnorm( s_x, mean = par[1], sd = par[2], log = TRUE )
		cdf     <- pnorm( s_x, mean = par[1], sd = par[2] )
		Shapiro <- shapiro.test(s_x)
		KS  <- suppressWarnings( ks.test(s_x, "pnorm", par[1], par[2]) )
	}
	if( dist == "pssn" )
	{ 
		log_pdf <- dssn( s_x, par = par, log = TRUE )
		cdf     <- pssn( s_x, par = par )
		Shapiro <- rep( NA, 2 )
		KS  <- suppressWarnings( ks.test(s_x, "pssn", par ) )
	}
	if( dist == "pst" )
	{ 
		log_pdf <- dst( s_x, par = par, log = TRUE )
		cdf     <- pst( s_x, par = par, k = 3 )
		Shapiro <- rep( NA, 2 )
		KS  <- suppressWarnings( ks.test(s_x, "pst", par, k = 3 ) )
	}
	if( dist == "pt" )
	{ 
		log_pdf <- dt( (s_x - par[1])/par[2], df = par[3], log = TRUE ) - log(par[2])
		cdf     <- pt( (s_x - par[1])/par[2], df = par[3] )
		Shapiro <- rep( NA, 2 )
		KS  <- suppressWarnings( ks.test((s_x - par[1])/par[2], "pt", par[3] ) )
	}
	if( dist == "pstab" )
	{ 
		log_pdf <- dstab( s_x, par = c(par[3], par[2], par[1]), log = TRUE )
		cdf     <- pstab( s_x, par = c(par[3], par[2], par[1]) )
		Shapiro <- rep( NA, 2 )
		KS  <- suppressWarnings( ks.test(s_x, "pstab", c(par[3], par[2], par[1]) ) )
	}
	cdf <- ifelse(cdf == 1, .Machine$double.eps, cdf)
	log_cdf <- log(cdf)
	log_cdf <- ifelse( is.finite( log_cdf ), log_cdf, NA )
	log_survival <- suppressWarnings( log(1 - cdf) )
	log.likelihood <- sum( log_pdf)
	AD  <- -n - sum( (2*index - 1)*log_cdf + (2*n + 1 - 2*index)*log_survival, na.rm = TRUE )/n
	AIC <- -2*log.likelihood + 2*npar
	BIC <- -2*log.likelihood + npar*log(n)
	CVM <- sum( ( cdf - (2*index - 1)/(2*n) )^2 ) + 1/(12*n)
	out1 <- cbind( AD, AIC, BIC, CVM, log.likelihood )
	colnames(out1) <- c( "AD", "AIC", "BIC", "CVM", "log.likelihood" )
	out2 <- cbind( KS$statistic[[1]], KS$p.value )
	if( dist == "pnorm" )
	{ 
		out3 <- cbind( Shapiro$statistic[[1]], Shapiro$p.value )
		out4 <- cbind( paste0("H0: error follows normal distribution.") )
	}else if( dist == "pscn" )
	{
		out3 <- cbind("NA", "NA") 
		out4 <- cbind( paste0("H0: error follows skew contaminated norma distribution.") )
	}else if( dist == "pssn")
	{
		out3 <- cbind("NA", "NA") 
		out4 <- cbind( paste0("H0: error follows skew slash normal distribution.") )
	}else if( dist == "pst" )
	{
		out3 <- cbind("NA", "NA") 
		out4 <- cbind( paste0("H0: error follows skew Student's t distribution.") )
	}else if( dist == "pt" )
	{
		out3 <- cbind("NA", "NA") 
		out4 <- cbind( paste0("H0: error follows Student's t distribution.") )
	}else if( dist == "pstab" )
	{
		out3 <- cbind("NA", "NA") 
		out4 <- cbind( paste0("H0: error follows symmetric stable distribution.") )
	}
	colnames(out2) <- colnames(out3) <- c( "statistics", "p.value" ); colnames(out4) <- c( " " )
	rownames(out1) <- rownames(out2) <- rownames(out3) <- rownames(out4) <- c( " " )
	list( "H0" = out4, "GOF_statistics" = out1, "KS_test" = out2,  "Shapiro_test" = out3 )
} 
