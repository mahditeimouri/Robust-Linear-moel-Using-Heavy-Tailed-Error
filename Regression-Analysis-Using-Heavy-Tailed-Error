			a0 <- a - m; b0 <- a + m
			w <- (b0 - a0)*(node + 1)/2 + a0
			for( r in 2:3 )
			{
				for( s in r:3 )
				{
					body( integrand ) <- bquote( .( quote( list_integrand[[r]](u, par) ) )*
									.( quote( list_integrand[[s]](u, par) ) )*
									.( quote( dt(u, df = par[3]) ) )   )
					out <- (b0 - a0)/2*sum( weight*integrand(w, psi) )
					M[(k - 1 + r ), (k - 1 + s)] <- M[(k - 1 + r ), (k - 1 + s)] + out
				}
			}
		}
Index <- which( upper.tri(M, diag = TRUE), arr.ind = TRUE )
M[ cbind( Index[, 2], Index[, 1] ) ] <- M[ cbind( Index[, 1], Index[, 2] ) ]
return( M )
}
