lmModel <- reactive({
	df <- req( data() ); df_dim <- dim(df); n <- df$y; p <- req( input$p ); model <- req( input$model0 )
	type <- req( input$type0 )
	if( df_dim[2] != (p + 1) ) stop("number of regressors is incorrect.")
	if( p == 1 )	
	{		
		x <- df$x; y <- df$y
	}else if( p > 1 )	
	{
		x_ind <- c(noquote(sapply(1:p, function(i) paste("df$x",i,sep="" ))))		
		x <- as.matrix( df[, colnames(df) != "y"], nrow = n, ncol = p )
		y <- df[, colnames(df) == "y"]	
	}
	if(model == "normal")
	{
		if( p == 1 )
		{
			out1 <- lm(y ~ x)
			out2 <- summary( out1 )
			Beta <- as.vector( out2$coefficients[, 1] )
			out3 <- c(noquote( c(noquote(paste("y =",sep=" ",round(Beta[1], 5) )), sapply(1:p, 
			function(i) paste0(ifelse(sign(Beta[i+1])>0,"+","-"),	sep=" ",round(abs(Beta[i+1]), 5),"*", "x") ) )))
			out <- list( summary = out2, model = out3, anova = anova(out1) )
		}else if( p > 1 )
		{
			relation <- noquote( c(noquote(paste("y~",sep="" )), sapply(1:(p - 1), 
			function(i) paste0("df$x",i,"+", sep="") ), noquote(paste("df$x",p,sep="" ))) )
			out1 <-  lm( as.formula(relation) ) 
			out2 <- summary( out1 )
			Beta <- as.vector( out2$coefficients[, 1] )
			out3 <- c(noquote( c(noquote(paste("y =",sep=" ",round(Beta[1], 5) )), sapply(1:p, 
					function(i) paste0(ifelse(sign(Beta[i+1])>0,"+","-"),	sep=" ",round(abs(Beta[i+1]), 5),"*", "x",i) ) )))
			x_colname <- c( noquote( c( "(Intercept)", sapply(1:p, function(i) (paste0("x",i)))[1:p] ) ))
			rownames(out2$coefficients) <- x_colname
			out4 <- anova(out1)
			rownames(out4) <- c(x_colname[-1], "Residuals")
			out <- list( summary = out2, model = out3, anova = out4 )
		}
		resi <- as.vector( out1$resi )
		coeff <- as.vector(out2$coefficients[, 1])
		y_hat <- c( coeff%*%t(cbind(1, x)) )
	}else
	{
			if( (model == "scn" & type == "mean") )
			{
				out <- robust_reg(y, x, type = "mean"    , model = "scn", Fisher = TRUE)
			}else if( (model == "scn" & type == "location") )
			{
				out <- robust_reg(y, x, type = "location", model = "scn", Fisher = TRUE)
			}else if( (model == "ssn" & type == "mean") )
			{
				out <- robust_reg(y, x, type = "mean"    , model = "ssn", Fisher = TRUE)
			}else if( (model == "ssn" & type == "location") )
			{
				out <- robust_reg(y, x, type = "location", model = "ssn", Fisher = TRUE)
			}else if( (model == "st" & type == "mean") )
			{
				out <- robust_reg(y, x, type = "mean"    , model = "st" , Fisher = TRUE)
			}else if( (model == "st" & type == "location") )
			{
				out <- robust_reg(y, x, type = "location", model = "st" , Fisher = TRUE)
			}else if( model == "t" )
			{
				out <- robust_reg(y, x, type = "mean"    , model = "t"  , Fisher = TRUE)
			}else if( model == "sas" )
			{
				out <- robust_reg(y, x, type = "mean"    , model = "sas", Fisher = TRUE)
			}
			coeff <- as.vector(out$coefficients[, 1])
			y_hat <- c( coeff%*%t(cbind(1, x)) )
			resi <- y - y_hat
	}
	return( list( out = out, resi = resi, y_hat = y_hat, coeff = coeff ) )
})
