dst <- function(x, par, log = FALSE)
{
	n <- length(x)
	PDF <- rep(NA, n)
	let <- !( is.na(x) | abs(x) == Inf )
	y <- x[let]
	mu = par[1]; sigma = par[2]; lambda = par[3]; nu = par[4]
	d <- (y - mu)/sigma
		if( lambda == 0 )
		{
			PDF[let] <- 1/sigma*dt(d, df = nu)
		}else{
			PDF[let] <- 2/sigma*dt(d, df = nu)*
					pt( lambda*d*sqrt((1 + nu)/(d^2 + nu)), df = 1 + nu )
		}
if( log == TRUE ) PDF[let] <- log( PDF[let] )
return(PDF)
}
