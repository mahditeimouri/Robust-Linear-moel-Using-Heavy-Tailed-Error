dscn <- function(x, par, log = FALSE)
{
	n <- length(x)
	PDF <- rep(NA, n)
	let <- !( is.na(x) | abs(x) == Inf )
	y <- x[let]
	mu = par[1]; sigma = par[2]; lambda = par[3]; nu = par[4]; gam = par[5]
	A <- lambda*(y - mu)/sigma
	PDF[let] <- 2*nu*dnorm(y, mean = mu, sd = sigma/sqrt(gam) )*pnorm( sqrt(gam)*A ) +
				2*(1 - nu)*dnorm(y, mean = mu, sd = sigma )*pnorm( A )
if( log == TRUE ) PDF[let] <- log( PDF[let] )
return(PDF)
}
