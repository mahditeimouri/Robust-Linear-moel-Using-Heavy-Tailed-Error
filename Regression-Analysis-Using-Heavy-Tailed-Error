pplot <- function(y, dist = "pnorm", par = c(0, 1), probs = c(0.25, 0.75),...) 
{
	n <- length(y)
	s_y <- sort(y)
	r <- (1:n - 0.5)/(n + 1)
	stopifnot( length(probs) == 2 )
	p1 <- floor( probs[1]*n )
	p2 <- floor( probs[2]*n )
	p3 <- c(s_y[p2], s_y[p1])
	if( dist == "pnorm" )
	{ 
		out <- pnorm( p3 , mean = par[1], sd = par[2] )
		p0  <- pnorm( s_y, mean = par[1], sd = par[2] )
	}
	if( dist == "pssn" )
	{ 
		out <- pssn( p3 , par = c(par[1], par[2], par[3], par[4]) )
		p0  <- pssn( s_y, par = c(par[1], par[2], par[3], par[4]) )
	}
	if( dist == "pst" )
