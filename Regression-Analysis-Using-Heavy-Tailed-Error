pst <- function(x, par, k=3, log.p = FALSE, lower.tail = TRUE)
{
	mu <- par[1]; sigma <- par[2]; lambda <- par[3]; nu <- par[4]
	tol <- 10e-8
	n <- length(x)
	CDF <- rep(NA, n)	
	let <- !( is.na(x) | abs(x) == Inf )
	delta <- (x - mu)/sigma
	delta <- delta[let]
	d_l <- sqrt( nu*( tol^( -2/(nu + 1) ) - 1) )
	g <- function(u, par0)
	{ 
	exp( log(2) + dt(u, df = nu, log = TRUE) + pt(par0*u*sqrt( (1 + nu)/(u^2 + nu) ), df = 1 + nu, log.p = TRUE) )
	}
	node <-	c(0.99312860, 0.96397193, 0.91223443, 0.83911697, 0.74633191, 0.63605368,
			  0.51086700, 0.37370609, 0.22778585, 0.07652652,-0.07652652,-0.22778585,
			 -0.37370609,-0.51086700,-0.63605368,-0.74633191,-0.83911697,-0.91223443,
			 -0.96397193,-0.99312860)
	weight <- c(0.01761401, 0.04060143, 0.06267205, 0.08327674, 0.10193012, 0.11819453,
			    0.13168864, 0.14209611, 0.14917299, 0.15275339, 0.15275339, 0.14917299,
			    0.14209611, 0.13168864, 0.11819453, 0.10193012, 0.08327674, 0.06267205,
			    0.04060143, 0.01761401) 
		if( lambda == 0 )
		{
			CDF <- pt(delta, df = nu)
		}else{
			lam <- -abs(lambda)
			par[3] <- lam
			sl <- sign(lambda)
			for(i in 1:n)
			{
					x <- -sl*delta[i]
					if( x < -k*d_l ) 
					{
						p <- (1 + sl)/2 - 2*sl*pt(x, df = nu)
					}else if( x >= -k*d_l & x < k*d_l )
					{
						res <- tryCatch( integrate(g, lower = -k*d_l, upper = x, par0 = lam)$value, 
									error = function(e)( "fail" ) )
						if( res[1] == "fail" )
						{        
							a <- -d_l; b <- x; z <- (b - a)*(node + 1)/2 + a 
							res <- (b - a)/2*sum( weight*dst(z, par = par) )
						}
						p <- (1 + sl)/2 - sl*min( 1, max(0, 2*pt(-k*d_l, df = nu) + res ) )
					}else{
						p <- 1 - ( (1 + sl)/2 -2*sl*( 1 - pt(x, df = nu) ) )
					}
			CDF[i] <- p
			}
		}
		CDF[let] <- CDF
CDF <- ifelse(CDF > 1, 1, CDF)
if(log.p == TRUE  & lower.tail == FALSE) CDF <- suppressWarnings( log(1 - CDF) )
if(log.p == TRUE  & lower.tail == TRUE ) CDF <- suppressWarnings( log(CDF) )
if(log.p == FALSE & lower.tail == FALSE) CDF <- suppressWarnings( 1 - CDF )
return(CDF)
}
