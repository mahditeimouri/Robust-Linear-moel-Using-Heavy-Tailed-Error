output$hist.error<- renderPlot({
	out <- req( lmModel() ); resi <- out$resi; model <- req( input$model0 )
	x0 <- seq(min(resi) - sd(resi), max(resi) + sd(resi), length.out = 100);
	n <- length(resi)
	#resi_tri <- subset( resi, (resi < quantile(resi, 0.8) & resi > quantile(resi, 0.2) ) )
	#dr0 <- diff(range(resi_tri))
	#br0 <- ceiling( dr0*n^(1/3)/( 2*diff( as.vector( quantile(resi_tri, c(0.25, 0.75)) )) ) )
	dr <- diff(range(resi))
	br <- ceiling( dr*n^(1/3)/( 2*diff( as.vector( quantile(resi, c(0.25, 0.75)) )) ) )	
	freq <- data.frame( table( cut(resi, br, labels = NULL, include.lowest = TRUE, right = TRUE, dig.lab = 4) ))
	
	if (model == "normal")
	{
		est <- c(mean(resi), sd(resi)); y0 <- dnorm(x0, mean = mean(resi), sd = sd(resi)); main_lab <- "Fitted normal density";
	}else if(model == "scn")
	{
		est <- out$out$error; y0 <- dscn(x0, par = est); main_lab <- "Fitted skew contaminated normal density";
	}else if(model == "ssn")
	{
		est <- out$out$error; y0 <- dssn(x0, par = est); main_lab <- "Fitted skew slash normal density";
	}else if(model == "st")
	{
		est <- out$out$error; y0 <- dst(x0, par = est); main_lab <- "Fitted skew t density";
	}else if(model == "t")
	{
		est <- out$out$error; y0 <- 1/est[2]*dt( (x0 - est[1])/est[2], df = est[3]); main_lab <- "Fitted Student t density";
	}else if(model == "sas")
	{
		est <- out$out$error; y0 <- dstab(x0, par = c(est[3], est[2], est[1]) ); main_lab <- "Fitted symmetric stable density";
	}
	pos <- "topright"
		if( all( model != c("normal", "t", "sas") ) )
		{
			est <- out$out$error; pos <- ifelse( est[3] > 0, "topright", "topleft")
		}
	hist(resi[-c(which.min(resi), which.max(resi))], br = br, prob = TRUE, ylim = c(0, br*max(freq$Freq)/(n*dr) + 0.05),
	mgp = c(2.5, 1, 0), col = 'steelblue', xlab = 'Residual', ylab = "Relative frequency", 
	main = main_lab, cex.main = 1.3, cex.lab = 1.3, cex.axis = 1.3, cex = 1.3)
	lines(x0, y0, lwd = 2, lty = 1, col = 'red')
	legend(pos, legend = "Density", bty = "n", lwd = 2, cex = 1.2, col = 'red', lty = 1)
	box(lwd=2)	
})
